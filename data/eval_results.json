      {
        "id": 4,
        "category": "direct",
        "question": "Can I cancel my order after it has shipped?",
        "should_escalate": false,
        "escalated": false,
        "top_score": 0.65,
        "latency_s": 2.07,
        "answer": "According to our policy [orders-and-cancellation.md], once the status is \"Preparing shipment\" or later, cancellation is no longer possible; instead, you can refuse delivery or return the item under the 30-day return policy (POL-RET-02).",
