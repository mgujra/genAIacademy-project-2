      },
      {
        "id": 5,
        "category": "direct",
        "question": "How long is the warranty and what does it cover?",
        "should_escalate": false,
        "escalated": false,
        "top_score": 0.483,
        "latency_s": 2.87,
        "answer": "The warranty for LumenLeaf devices is 2 years from the delivery date, which can be extended to 2.5 years (30 months) if you register the device in the app within 60 days of purchase [warranty-policy.md]. The warranty covers manufacturing defects such as dead pixels/LED segments, failure to power on, Wi-Fi radio failure, and overload protection failures within the rated load [warranty-policy.md].",
        "sources": [
          "account-management.md",
          "product-manual-hub-plug.md",
          "returns-and-refunds.md",
          "warranty-policy.md"
        ],
        "escalation_correct": true,
        "has_citation": true,
        "faithfulness": {
          "score": 4,
          "issue": "minor paraphrase liberties"
        }
      },
      {
        "id": 6,
        "category": "exact-code",
        "question": "What does error LL-E45 mean?",
        "should_escalate": false,
        "escalated": false,
        "top_score": 0.367,
        "latency_s": 2.38,
        "answer": "Error LL-E45 means the connected load exceeded 1800W, causing the LL-P50 smart plug to cut power [troubleshooting-guide.md]. To resolve, unplug the appliance, press the side button once to clear, and connect a smaller load [troubleshooting-guide.md].",
        "sources": [
          "product-manual-hub-plug.md",
          "support-tickets-samples.md",
          "troubleshooting-guide.md"
        ],
        "escalation_correct": true,
        "has_citation": true,
        "faithfulness": {
          "score": 5,
          "issue": "none"
        }
      },
      {
